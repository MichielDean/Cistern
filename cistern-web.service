[Unit]
Description=Cistern Web Dashboard — HTTP server on port 5737
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10
StartLimitAction=none

[Service]
Type=simple
ExecStart=/home/lobsterdog/go/bin/ct dashboard --web --addr :5737

# Always restart — covers OOM kills, crashes, and clean exits so the
# dashboard survives memory pressure and reboots without manual intervention.
Restart=always
RestartSec=10

# Regression guard (ci-5n337): the web dashboard OOM'd at 2.6G after ~9d due
# to unbounded SSE connections + a growing TUI pending frame buffer. Steady
# state is tens of MB per soak sampling; 512M is 5x headroom for the
# dashboard + Bubble Tea child. If the process ever exceeds this, systemd
# kills it instead of letting a leak take down the host.
MemoryMax=512M

TimeoutStopSec=10
KillMode=mixed
KillSignal=SIGTERM

StandardOutput=append:/home/lobsterdog/.cistern/web.log
StandardError=append:/home/lobsterdog/.cistern/web.log

Environment=HOME=/home/lobsterdog
Environment=PATH=/home/lobsterdog/go/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
